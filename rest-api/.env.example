# MySQL connection settings
DB_HOST=127.0.0.1:3306
DB_USER=root
DB_PASSWORD=
DB_NAME=habr_companies

# API key for X-API-Key header authentication
COMPANY_API_KEY=your-secure-random-key-here

# ngrok authtoken (get yours at https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# Optional: path to ngrok executable (default: tries ngrok.exe from PATH and common install locations)
# NGROK_EXE=C:\path\to\ngrok.exe

# Optional listen address (default :8080)
# HTTP_ADDR=:8080
